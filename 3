def plot_heatmap(df_mat: pd.DataFrame, title: str, out_path: str):
    fig, ax = plt.subplots(figsize=(8, 6))
    im = ax.imshow(df_mat.values, aspect="auto")
    ax.set_xticks(range(len(df_mat.columns)))
    ax.set_yticks(range(len(df_mat.index)))
    ax.set_xticklabels(df_mat.columns, rotation=45, ha="right")
    ax.set_yticklabels(df_mat.index)
    ax.set_title(title)

    # annotate
    for i in range(df_mat.shape[0]):
        for j in range(df_mat.shape[1]):
            v = df_mat.values[i, j]
            s = "" if np.isnan(v) else f"{v:.2f}"
            ax.text(j, i, s, ha="center", va="center", fontsize=8)

    fig.colorbar(im, ax=ax, fraction=0.046, pad=0.04)
    plt.tight_layout()
    plt.savefig(out_path, dpi=300)
    plt.close(fig)


def plot_bar(values: pd.DataFrame, x: str, y: str, title: str, out_path: str):
    fig, ax = plt.subplots(figsize=(9, 5))
    ax.bar(values[x].astype(str), values[y].astype(float))
    ax.set_title(title)
    ax.set_xlabel(x)
    ax.set_ylabel(y)
    ax.set_xticklabels(values[x].astype(str), rotation=30, ha="right")
    plt.tight_layout()
    plt.savefig(out_path, dpi=300)
    plt.close(fig)


def plot_scatter(x: pd.Series, y: pd.Series, title: str, xlabel: str, ylabel: str, out_path: str):
    fig, ax = plt.subplots(figsize=(7, 5))
    mask = x.notna() & y.notna()
    ax.scatter(x[mask], y[mask])
    ax.set_title(title)
    ax.set_xlabel(xlabel)
    ax.set_ylabel(ylabel)
    plt.tight_layout()
    plt.savefig(out_path, dpi=300)
    plt.close(fig)


# -----------------------------
# 6) MAIN PIPELINE
# -----------------------------

def main():
    outdirs = ensure_outdirs(CONFIG["out_dir"])

    # ---- Load all agents ----
    dfs = []
    for spec in AGENTS:
        try:
            dfs.append(load_agent(spec))
        except FileNotFoundError as e:
            print(f"[WARN] {e}  -> skipping agent: {spec.name}")

    if not dfs:
        raise RuntimeError("No datasets loaded. Check paths in AGENTS[].")

    # Merge on record_id (outer to keep everything)
    merged = dfs[0]
    for d in dfs[1:]:
        merged = merged.merge(d, on="record_id", how="outer", suffixes=("", "_dup"))

    # Remove duplicate metadata columns created by merge
    dup_cols = [c for c in merged.columns if c.endswith("_dup")]
    merged.drop(columns=dup_cols, inplace=True, errors="ignore")

    # ---- Identify humans and AIs successfully loaded ----
    loaded_agent_names = []
    for spec in AGENTS:
        if any(c.startswith(spec.name + "__") for c in merged.columns):
            loaded_agent_names.append(spec.name)

    human_agents = [a.name for a in AGENTS if a.kind == "human" and a.name in loaded_agent_names]
    ai_agents = [a.name for a in AGENTS if a.kind == "ai" and a.name in loaded_agent_names]

    print("\nLoaded humans:", human_agents)
    print("Loaded AIs   :", ai_agents)

    if len(human_agents) < 2:
        raise RuntimeError("Need at least 2 human files loaded to compute consensus/HighConf.")

    # ---- Build human consensus + HighConf ----
    merged = build_human_consensus(merged, human_agents)

    # Define subsets
    mask_all = pd.Series(True, index=merged.index)
    mask_highconf = merged["is_highconf"] == True
    mask_3_0 = merged["human_consensus"] == "3-0"
    mask_2_1 = merged["human_consensus"] == "2-1"

    print("\nCounts:")
    print("  total records:", len(merged))
    print("  HighConf:", int(mask_highconf.sum()), "| 3-0:", int(mask_3_0.sum()), "| 2-1:", int(mask_2_1.sum()))

    # ---- Human-human agreement (HighConf) ----
    kappa_hh = pairwise_kappa_matrix(merged, human_agents, mask_highconf)
    kappa_hh.to_csv(os.path.join(outdirs["tables"], "kappa_human_human_highconf.csv"))
    plot_heatmap(kappa_hh, "Human–Human Cohen’s κ (HighConf)", os.path.join(outdirs["figs"], "Fig_kappa_human_human_highconf.png"))

    # ---- AI vs Human Majority (HighConf primary) ----
    rows = []
    for ai in ai_agents:
        m = classification_metrics(merged.loc[mask_highconf, "human_majority_label"], merged.loc[mask_highconf, f"{ai}__label"])
        m["agent"] = ai
        rows.append(m)
    ai_vs_cons = pd.DataFrame(rows).sort_values(["kappa", "accuracy"], ascending=False)
    ai_vs_cons.to_csv(os.path.join(outdirs["tables"], "ai_vs_human_majority_highconf.csv"), index=False)

    plot_bar(
        ai_vs_cons,
        x="agent",
        y="kappa",
        title="AI vs Human Majority — Cohen’s κ (HighConf)",
        out_path=os.path.join(outdirs["figs"], "Fig_ai_vs_human_majority_kappa_highconf.png"),
    )
    plot_bar(
        ai_vs_cons,
        x="agent",
        y="accuracy",
        title="AI vs Human Majority — Accuracy (HighConf)",
        out_path=os.path.join(outdirs["figs"], "Fig_ai_vs_human_majority_accuracy_highconf.png"),
    )

    # ---- Pairwise kappa across ALL agents (HighConf) ----
    all_agents = human_agents + ai_agents
    kappa_all = pairwise_kappa_matrix(merged, all_agents, mask_highconf)
    kappa_all.to_csv(os.path.join(outdirs["tables"], "kappa_all_agents_highconf.csv"))
    plot_heatmap(kappa_all, "All Agents Cohen’s κ (HighConf)", os.path.join(outdirs["figs"], "Fig_kappa_all_agents_highconf.png"))

    # ---- Reasoning similarity (TF-IDF cosine) (HighConf) ----
    corpus = build_reason_corpus(merged, all_agents, mask_highconf)
    if len(corpus) < 50:
        print("[WARN] Reason corpus is small; reasoning similarity may be unstable. Consider lowering min_df.")
    vectorizer = TfidfVectorizer(
        min_df=CONFIG["tfidf_min_df"],
        max_features=CONFIG["tfidf_max_features"],
        ngram_range=CONFIG["tfidf_ngram_range"],
        stop_words="english",
    )
    vectorizer.fit(corpus if corpus else ["placeholder"])

    # Compute pairwise reasoning similarity summary (HighConf)
    reason_summary = []
    for a, b in itertools.combinations(all_agents, 2):
        sims, stats = reasoning_similarity_pair(merged, a, b, vectorizer, mask_highconf)
        reason_summary.append({"agent_a": a, "agent_b": b, **stats})
    reason_summary_df = pd.DataFrame(reason_summary).sort_values("mean", ascending=False)
    reason_summary_df.to_csv(os.path.join(outdirs["tables"], "reason_similarity_pairwise_highconf.csv"), index=False)

    # ---- Composite closeness ranking (classification + reasoning) (HighConf) ----
    composite_rows = []
    for a, b in itertools.combinations(all_agents, 2):
        sub = merged.loc[mask_highconf].copy()

        la = sub[f"{a}__label"]
        lb = sub[f"{b}__label"]
        class_agree = (la.notna() & lb.notna() & (la.astype(str) == lb.astype(str))).astype(float)
        class_agree = class_agree.where(la.notna() & lb.notna(), np.nan)

        reason_sim, _ = reasoning_similarity_pair(merged, a, b, vectorizer, mask_highconf)

        comp = composite_similarity(class_agree, reason_sim)
        composite_rows.append({
            "agent_a": a,
            "agent_b": b,
            "n_class": int((class_agree.notna()).sum()),
            "class_agreement_rate": float(np.nanmean(class_agree)),
            "n_reason": int((reason_sim.notna()).sum()),
            "reason_mean_cosine": float(np.nanmean(reason_sim)),
            "composite_mean": float(np.nanmean(comp)),
        })

    composite_df = pd.DataFrame(composite_rows).sort_values("composite_mean", ascending=False)
    composite_df.to_csv(os.path.join(outdirs["tables"], "composite_closeness_ranking_highconf.csv"), index=False)

    # Scatter: reasoning vs class agreement for top pair (visual intuition)
    if len(composite_df) > 0:
        top = composite_df.iloc[0]
        a, b = top["agent_a"], top["agent_b"]
        sub = merged.loc[mask_highconf].copy()

        la = sub[f"{a}__label"]
        lb = sub[f"{b}__label"]
        class_agree = (la.notna() & lb.notna() & (la.astype(str) == lb.astype(str))).astype(float)
        class_agree = class_agree.where(la.notna() & lb.notna(), np.nan)

        reason_sim, _ = reasoning_similarity_pair(merged, a, b, vectorizer, mask_highconf)
        plot_scatter(
            x=reason_sim,
            y=class_agree,
            title=f"Top Pair: {a} vs {b} — Reasoning Cosine vs Label Agreement (HighConf)",
            xlabel="Reasoning similarity (cosine)",
            ylabel="Label agreement (0/1)",
            out_path=os.path.join(outdirs["figs"], "Fig_top_pair_reason_vs_label_agreement.png"),
        )

    # ---- AI confidence vs correctness correlation (HighConf) ----
    # correctness defined vs human majority
    corr_rows = []
    for ai in ai_agents:
        sub = merged.loc[mask_highconf].copy()
        y_true = sub["human_majority_label"].astype(str)
        y_pred = sub[f"{ai}__label"].astype(str)
        correct = (y_true == y_pred).astype(float)
        conf = pd.to_numeric(sub[f"{ai}__conf"], errors="coerce")

        valid = conf.notna()
        if valid.sum() >= 10:
            # Spearman correlation without importing scipy.stats (simple rank corr)
            conf_rank = conf[valid].rank()
            corr = conf_rank.corr(correct[valid])
        else:
            corr = np.nan

        corr_rows.append({"agent": ai, "n": int(valid.sum()), "spearman_approx": float(corr) if corr == corr else np.nan})

    corr_df = pd.DataFrame(corr_rows).sort_values("spearman_approx", ascending=False)
    corr_df.to_csv(os.path.join(outdirs["tables"], "ai_confidence_vs_correctness_highconf.csv"), index=False)

    # ---- Save an Excel summary workbook ----
    xlsx_path = os.path.join(outdirs["base"], "report_summary.xlsx")
    with pd.ExcelWriter(xlsx_path, engine="openpyxl") as writer:
        merged.to_excel(writer, sheet_name="Merged_Data", index=False)
        ai_vs_cons.to_excel(writer, sheet_name="AI_vs_HumanMajority", index=False)
        kappa_hh.to_excel(writer, sheet_name="Kappa_HumanHuman")
        kappa_all.to_excel(writer, sheet_name="Kappa_AllAgents")
        reason_summary_df.to_excel(writer, sheet_name="Reason_Similarity", index=False)
        composite_df.to_excel(writer, sheet_name="Composite_Ranking", index=False)
        corr_df.to_excel(writer, sheet_name="AI_Conf_vs_Correct", index=False)

    print("\nDONE.")
    print(f"Outputs written to: {os.path.abspath(outdirs['base'])}")
    print(f"Excel summary: {os.path.abspath(xlsx_path)}")


if __name__ == "__main__":
    main()
