# 2) CONSENSUS + FILTERS
# -----------------------------

def build_human_consensus(df: pd.DataFrame, human_agents: List[str]) -> pd.DataFrame:
    """
    Adds:
      human_majority_label
      human_majority_votes
      human_consensus (3-0 / 2-1 / tie / missing)
      is_highconf (3-0 & 2-1 only)
    """
    label_cols = [f"{h}__label" for h in human_agents]

    def row_consensus(row):
        labels = [row[c] for c in label_cols]
        labels_clean = [x for x in labels if x is not None and str(x).strip() != ""]
        n_present = len(labels_clean)

        if CONFIG["require_all_humans_present_for_highconf"] and n_present != len(label_cols):
            return (None, 0, "missing", False)

        if n_present == 0:
            return (None, 0, "missing", False)

        vc = pd.Series(labels_clean).value_counts()
        maj_label = vc.index[0]
        maj_votes = int(vc.iloc[0])

        # tie (e.g., 1-1-1)
        if len(vc) > 1 and vc.iloc[0] == vc.iloc[1]:
            return (None, maj_votes, "tie", False)

        if maj_votes == 3:
            return (maj_label, 3, "3-0", True)
        if maj_votes == 2:
            return (maj_label, 2, "2-1", True)
        return (maj_label, maj_votes, f"{maj_votes}-{n_present-maj_votes}", False)

    tmp = df.apply(row_consensus, axis=1, result_type="expand")
    df["human_majority_label"] = tmp[0]
    df["human_majority_votes"] = tmp[1]
    df["human_consensus"] = tmp[2]
    df["is_highconf"] = tmp[3]
    return df


