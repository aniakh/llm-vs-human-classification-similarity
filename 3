def ensure_outdirs(base: str) -> Dict[str, str]:
    tables = os.path.join(base, "tables")
    figs = os.path.join(base, "figures")
    os.makedirs(tables, exist_ok=True)
    os.makedirs(figs, exist_ok=True)
    return {"base": base, "tables": tables, "figs": figs}


def find_file(path_or_name: str) -> str:
    """
    Allows you to pass either:
      - exact path
      - filename in current folder
      - filename somewhere under cwd (via glob)
    """
    if os.path.exists(path_or_name):
        return path_or_name

    # Try in current directory
    if os.path.exists(os.path.join(os.getcwd(), path_or_name)):
        return os.path.join(os.getcwd(), path_or_name)

    # Try recursive search
    hits = glob.glob(f"**/{path_or_name}", recursive=True)
    if hits:
        return hits[0]

    raise FileNotFoundError(f"Could not find: {path_or_name}")


def parse_eid_from_link(link: str) -> Optional[str]:
    if not isinstance(link, str):
        return None
    m = re.search(r"eid=(2-s2\.0-\d+)", link)
    return m.group(1) if m else None


def normalize_doi(doi: str) -> Optional[str]:
    if not isinstance(doi, str) or not doi.strip():
        return None
    d = doi.strip().lower()
    # remove common URL prefix if present
    d = re.sub(r"^https?://(dx\.)?doi\.org/", "", d)
    return d


def normalize_label(x: str) -> Optional[str]:
    if x is None or (isinstance(x, float) and np.isnan(x)):
        return None
    s = str(x).strip()
    if not s:
        return None
    s_low = s.lower().strip()
    return CONFIG["label_normalization_map"].get(s_low, s)


def make_title_year_hash(title: str, year: str) -> str:
    t = (title or "").strip().lower()
    y = (year or "").strip()
    base = (t + "|" + y).encode("utf-8", errors="ignore")
    # simple stable hash (not cryptographic)
    return str(abs(hash(base)))


def infer_column(df: pd.DataFrame, candidates: List[str]) -> Optional[str]:
    cols = list(df.columns)
    cols_low = {c.lower(): c for c in cols}

    # exact-ish match
    for cand in candidates:
        if cand.lower() in cols_low:
            return cols_low[cand.lower()]

    # contains match
    for c in cols:
        cl = c.lower()
        for cand in candidates:
            if cand.lower() in cl:
                return c
    return None


def load_agent(spec: AgentSpec) -> pd.DataFrame:
    file_path = find_file(spec.path)
    ext = os.path.splitext(file_path)[1].lower()

    if ext in [".xlsx", ".xls"]:
        df = pd.read_excel(file_path)
    elif ext == ".csv":
        df = pd.read_csv(file_path)
    else:
        raise ValueError(f"Unsupported file type: {ext}")

    # ---- infer common metadata columns ----
    col_doi = infer_column(df, ["DOI", "doi"])
    col_link = infer_column(df, ["Link", "link", "scopus link"])
    col_title = infer_column(df, ["Title", "title", "Document Title"])
    col_year = infer_column(df, ["Year", "year", "Publication Year"])

    # ---- infer label/conf/reason ----
    col_label = spec.col_label or infer_column(df, ["Human_Category", "Category", "Class", "Label", "Final Category"])
    col_conf = spec.col_conf or infer_column(df, ["Human_Confidence", "Confidence", "Conf", "Certainty"])
    col_reason = spec.col_reason or infer_column(df, ["Human_Reason", "Reason", "Reasoning", "Rationale", "Justification", "Notes"])

    # Log what we inferred (useful when you run)
    print(f"\n[{spec.name}] Loaded: {file_path}")
    print(f"  inferred DOI={col_doi}, Link={col_link}, Title={col_title}, Year={col_year}")
    print(f"  inferred Label={col_label}, Conf={col_conf}, Reason={col_reason}")

    # Build record_id
    doi_norm = df[col_doi].apply(normalize_doi) if col_doi else pd.Series([None] * len(df))
    eid = df[col_link].apply(parse_eid_from_link) if col_link else pd.Series([None] * len(df))

    title = df[col_title].astype(str) if col_title else pd.Series([""] * len(df))
    year = df[col_year].astype(str) if col_year else pd.Series([""] * len(df))
    title_year_hash = [make_title_year_hash(t, y) for t, y in zip(title, year)]

    record_id = []
    for d, e, h in zip(doi_norm, eid, title_year_hash):
        if "doi" in CONFIG["id_priority"] and d:
            record_id.append("doi:" + d)
        elif "eid" in CONFIG["id_priority"] and e:
            record_id.append("eid:" + e)
        else:
            record_id.append("hash:" + h)

    out = pd.DataFrame({"record_id": record_id})

    # Standardized fields
    out[f"{spec.name}__label"] = df[col_label].apply(normalize_label) if col_label else None
    out[f"{spec.name}__conf"] = df[col_conf] if col_conf else np.nan
    out[f"{spec.name}__reason"] = df[col_reason].astype(str) if col_reason else ""

    # Keep some metadata if present
    if col_doi:
        out["DOI"] = doi_norm
    if col_title:
        out["Title"] = df[col_title].astype(str)
    if col_year:
        out["Year"] = df[col_year]

    return out


