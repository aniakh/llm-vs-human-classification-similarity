def classification_metrics(y_true: pd.Series, y_pred: pd.Series) -> Dict[str, float]:
    mask = y_true.notna() & y_pred.notna()
    y_t = y_true[mask].astype(str)
    y_p = y_pred[mask].astype(str)

    if len(y_t) == 0:
        return {"n": 0, "accuracy": np.nan, "macro_f1": np.nan, "kappa": np.nan}

    return {
        "n": int(len(y_t)),
        "accuracy": float(accuracy_score(y_t, y_p)),
        "macro_f1": float(f1_score(y_t, y_p, average="macro")),
        "kappa": float(cohen_kappa_score(y_t, y_p)),
    }


def pairwise_kappa_matrix(df: pd.DataFrame, agent_names: List[str], subset_mask: pd.Series) -> pd.DataFrame:
    agents = agent_names[:]
    mat = pd.DataFrame(index=agents, columns=agents, dtype=float)

    sub = df.loc[subset_mask].copy()
    for a, b in itertools.product(agents, agents):
        if a == b:
            mat.loc[a, b] = 1.0
            continue
        ya = sub[f"{a}__label"]
        yb = sub[f"{b}__label"]
        mask = ya.notna() & yb.notna()
        if mask.sum() == 0:
            mat.loc[a, b] = np.nan
        else:
            mat.loc[a, b] = float(cohen_kappa_score(ya[mask].astype(str), yb[mask].astype(str)))
    return mat


# -----------------------------
# 4) REASONING SIMILARITY
# -----------------------------

def preprocess_reason(text: str) -> str:
    if not isinstance(text, str):
        return ""
    t = text.strip()
    t = re.sub(r"\s+", " ", t)
    return t


def build_reason_corpus(df: pd.DataFrame, agent_names: List[str], subset_mask: pd.Series) -> List[str]:
    corpus = []
    sub = df.loc[subset_mask]
    for a in agent_names:
        col = f"{a}__reason"
        if col in sub.columns:
            corpus.extend([preprocess_reason(x) for x in sub[col].fillna("").astype(str).tolist()])
    # remove empties
    corpus = [c for c in corpus if c]
    return corpus


def reasoning_similarity_pair(
    df: pd.DataFrame,
    a: str,
    b: str,
    vectorizer: TfidfVectorizer,
    subset_mask: pd.Series,
) -> Tuple[pd.Series, Dict[str, float]]:
    sub = df.loc[subset_mask].copy()
    ra = sub[f"{a}__reason"].fillna("").astype(str).apply(preprocess_reason)
    rb = sub[f"{b}__reason"].fillna("").astype(str).apply(preprocess_reason)

    valid = (ra != "") & (rb != "")
    sims = pd.Series(np.nan, index=sub.index, dtype=float)

    if valid.sum() == 0:
        return sims, {"n": 0, "mean": np.nan, "median": np.nan}

    X = vectorizer.transform(ra[valid].tolist())
    Y = vectorizer.transform(rb[valid].tolist())
    # cosine similarity row-wise
    sim_vals = np.array([cosine_similarity(X[i], Y[i])[0, 0] for i in range(X.shape[0])], dtype=float)

    sims.loc[valid] = sim_vals
    return sims, {
        "n": int(valid.sum()),
        "mean": float(np.nanmean(sim_vals)),
        "median": float(np.nanmedian(sim_vals)),
    }


def composite_similarity(class_agree: pd.Series, reason_sim: pd.Series) -> pd.Series:
    """
    Composite in [0,1] (NaNs handled).
    class_agree: 1 if same label else 0, NaN if missing
    reason_sim : cosine in [0,1], NaN if missing
    """
    wc = CONFIG["w_class"]
    wr = CONFIG["w_reason"]

    # If one component missing, fall back to the other
    out = pd.Series(np.nan, index=class_agree.index, dtype=float)
    both = class_agree.notna() & reason_sim.notna()
    out.loc[both] = wc * class_agree.loc[both] + wr * reason_sim.loc[both]

    only_c = class_agree.notna() & reason_sim.isna()
    out.loc[only_c] = class_agree.loc[only_c]

    only_r = class_agree.isna() & reason_sim.notna()
    out.loc[only_r] = reason_sim.loc[only_r]

    return out


